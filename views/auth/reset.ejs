<div class="auth-card mx-auto">
  <h1 class="h5 fw-bold mb-3">নতুন পাসওয়ার্ড</h1>
  <form method="post" action="/reset-password/<%= token %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="form-label">পাসওয়ার্ড</label>
    <input class="form-control mb-3" type="password" name="password" minlength="8" required>
    <button class="btn btn-primary w-100">সংরক্ষণ</button>
  </form>
</div>
