<div class="page-heading">
  <div>
    <p>বিনিয়োগের লাভ এন্ট্রি ও শেয়ারভিত্তিক বণ্টন</p>
    <h1>লাভ ব্যবস্থাপনা</h1>
  </div>
  <a class="btn btn-outline-primary" href="/admin/profits/share">
    <span class="material-symbols-outlined">diversity_3</span> শেয়ারভিত্তিক বণ্টন
  </a>
</div>

<!-- Bento Stats Cards -->
<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start w-full mb-2">
        <div class="stat-icon success" style="background: rgba(0, 87, 205, 0.1); color: var(--primary);"><span class="material-symbols-outlined">account_balance</span></div>
      </div>
      <span>মোট অর্জিত লাভ</span>
      <strong class="text-primary"><%= money(stats.totalProfit) %></strong>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start w-full mb-2">
        <div class="stat-icon success" style="background: rgba(0, 109, 65, 0.1); color: var(--secondary);"><span class="material-symbols-outlined">paid</span></div>
      </div>
      <span>এই মাসের লাভ</span>
      <strong><%= money(stats.thisMonthProfit) %></strong>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start w-full mb-2">
        <div class="stat-icon success" style="background: rgba(186, 26, 26, 0.1); color: var(--tertiary);"><span class="material-symbols-outlined">volunteer_activism</span></div>
      </div>
      <span>বিতরণকৃত লভ্যাংশ</span>
      <strong><%= money(stats.distributedProfit) %></strong>
    </div>
  </div>
</div>

<div class="row g-4 mb-4">
  <!-- Profit Entry Form -->
  <div class="col-lg-7">
    <div class="panel h-100 relative overflow-hidden" style="min-height: 400px;">
      <h2 class="mb-4 d-flex align-items-center gap-2" style="font-size: 20px; font-weight: 800;">
        <span class="material-symbols-outlined text-primary">add_circle</span> নতুন লাভের হিসাব যোগ করুন
      </h2>
      <form method="post" action="/admin/profits" class="row g-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        
        <div class="col-md-12">
          <label class="form-label">বিনিয়োগ প্রকল্প নির্বাচন করুন</label>
          <select class="form-select" name="investmentId" required>
            <option value="">প্রকল্প বাছাই করুন</option>
            <% investments.forEach(i => { %>
              <option value="<%= i.id %>"><%= i.title %> (বিনিয়োগ: <%= money(i.amount) %>)</option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-6">
          <label class="form-label">লাভের পরিমাণ (টাকা)</label>
          <input class="form-control" name="amount" type="number" placeholder="৳ ০০.০০" required>
        </div>

        <div class="col-md-6">
          <label class="form-label">লাভের তারিখ</label>
          <input class="form-control" name="profitDate" type="date" required value="<%= new Date().toISOString().substring(0, 10) %>">
        </div>

        <div class="col-md-12">
          <label class="form-label">লাভের সংক্ষিপ্ত বিবরণ / নোট</label>
          <textarea class="form-control" name="description" placeholder="লভ্যাংশ বণ্টন বা প্রকল্পের অতিরিক্ত বিবরণ..." rows="3"></textarea>
        </div>

        <div class="col-12 mt-4 text-end">
          <button class="btn btn-primary" type="submit">
            <span class="material-symbols-outlined">check_circle</span> লাভ বণ্টন নিশ্চিত করুন
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Distribution Chart Card -->
  <div class="col-lg-5">
    <div class="panel h-100 d-flex flex-column justify-content-between">
      <h2 style="font-size: 20px; font-weight: 800; margin-bottom: 15px;">প্রকল্পভিত্তিক লভ্যাংশ বণ্টন</h2>
      <div class="d-flex align-items-center justify-content-center flex-grow-1 py-3">
        <canvas id="profitDonutChart" style="max-height: 220px; max-width: 220px;"></canvas>
      </div>
      <div id="noProfitMsg" class="text-center text-muted d-none py-5">
        <span class="material-symbols-outlined text-4xl mb-2">analytics</span>
        <p>চার্ট প্রদর্শনের জন্য কোনো লাভ এন্ট্রি নেই।</p>
      </div>
    </div>
  </div>
</div>

<!-- Profit History Table -->
<div class="panel table-panel">
  <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
    <h2 class="m-0" style="font-size: 18px; font-weight: 800;">লাভের ইতিহাস ও লেনদেন</h2>
  </div>
  <div class="table-responsive">
    <table class="table data-table align-middle">
      <thead>
        <tr style="background-color: var(--surface-low); color: var(--muted);">
          <th>বিনিয়োগ প্রকল্প</th>
          <th class="text-end">লভ্যাংশ পরিমাণ</th>
          <th>তারিখ</th>
          <th>বিবরণ</th>
        </tr>
      </thead>
      <tbody>
        <% profits.forEach(p => { %>
          <tr>
            <td>
              <div class="d-flex align-items-center gap-2">
                <div class="avatar-circle" style="width: 32px; height: 32px; font-size: 14px; border-radius: 8px;">
                  <%= p.Investment ? p.Investment.title.substring(0, 1) : 'ব' %>
                </div>
                <strong><%= p.Investment ? p.Investment.title : 'Deleted Project' %></strong>
              </div>
            </td>
            <td class="text-end fw-bold text-success"><%= money(p.amount) %></td>
            <td><%= p.profitDate ? new Date(p.profitDate).toLocaleDateString('bn-BD', { day: 'numeric', month: 'short', year: 'numeric' }) : '---' %></td>
            <td class="text-muted"><%= p.description || '---' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Aggregate profit per investment project for Donut Chart
    const profitData = {};
    <% profits.forEach(p => { %>
      <% if (p.Investment) { %>
        const title = '<%= p.Investment.title %>';
        const amount = Number('<%= p.amount %>');
        profitData[title] = (profitData[title] || 0) + amount;
      <% } %>
    <% }) %>

    const labels = Object.keys(profitData);
    const dataValues = Object.values(profitData);

    if (labels.length === 0) {
      document.getElementById('profitDonutChart').classList.add('d-none');
      document.getElementById('noProfitMsg').classList.remove('d-none');
    } else {
      const ctx = document.getElementById('profitDonutChart').getContext('2d');
      new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: labels,
          datasets: [{
            data: dataValues,
            backgroundColor: [
              '#0057cd',
              '#006d41',
              '#e67e22',
              '#b91830',
              '#9b59b6',
              '#1abc9c',
              '#34495e',
              '#95a5a6'
            ],
            borderWidth: 2,
            borderColor: 'var(--surface-card)'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                font: {
                  family: 'Noto Sans Bengali',
                  size: 11
                },
                color: 'var(--text)'
              }
            }
          }
        }
      });
    }
  });
</script>
