<div class="page-heading"><div><p>নতুন নোটিশ প্রকাশ করলে push notification যাবে</p><h1>নোটিশ</h1></div></div>
<form method="post" action="/admin/notices" class="panel mb-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-3"><div class="col-md-5"><label class="form-label">Title</label><input class="form-control" name="title" required></div><div class="col-md-3"><label class="form-label">Publish Date</label><input class="form-control" name="publishDate" type="date" required></div><div class="col-md-4 d-flex align-items-end"><button class="btn btn-primary">প্রকাশ করুন</button></div><div class="col-12"><label class="form-label">Description</label><textarea class="form-control" name="description" required></textarea></div></div></form>
<div class="notice-grid"><% notices.forEach(n => { %><div class="notice"><strong><%= n.title %></strong><span><%= n.publishDate %></span><p><%= n.description %></p></div><% }) %></div>
